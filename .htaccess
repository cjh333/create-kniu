# KniuSystem 敏感路径防护（Apache；nginx 等价配置见 README「生产部署敏感路径防护」）。
# 前提：docroot 指向项目根时，以下路径一律禁止 HTTP 直读。
Options -Indexes

# ① 点文件与点目录（.env / .git / .htaccess 自身等）一律 404
RedirectMatch 404 (^|/)\.

# ② 运行时数据与项目档案目录（会话/登录锁/明文连接凭证/请求日志/SQL 基线）
RedirectMatch 404 ^/runtime/
RedirectMatch 404 ^/api/runtime/
RedirectMatch 404 ^/!KniuProject/

# ③ 全仓 SQL / 日志 / 凭证类文件兜底
<FilesMatch "\.(sql|log|env|ini)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
